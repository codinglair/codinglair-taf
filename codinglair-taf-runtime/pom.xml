<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codinglair.taf</groupId>
        <artifactId>codinglair-taf</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>codinglair-taf-runtime</artifactId>
    <packaging>pom</packaging>
    <name>TAF Runtime</name>
    <description>Core runtime module providing deterministic, independently usable test capabilities</description>

    <modules>
        <module>codinglair-taf-runtime-core</module>
        <module>taf-secrets-api</module>
        <module>taf-secrets-local</module>
        <module>taf-test-definitions</module>
        <module>taf-file</module>
        <module>taf-test-definitions-mongodb</module>
        <module>taf-web-playwright</module>
        <module>taf-mobile-core</module>
        <module>taf-mobile-appium</module>
        <module>taf-api-rest</module>
        <module>taf-virtualization-wiremock</module>
        <module>taf-api-soap</module>
        <module>taf-contracts</module>
        <module>taf-messaging-core</module>
        <module>taf-messaging-kafka</module>
        <module>taf-messaging-rabbitmq</module>
        <module>taf-messaging-jms</module>
        <module>taf-environments</module>
        <module>taf-database</module>
        <module>taf-observability</module>
        <module>taf-data-migration</module>
        <module>codinglair-taf-reporting-allure</module>
        <module>codinglair-taf-runner-testng</module>
        <module>codinglair-taf-runner-cucumber</module>
        <module>taf-consumer-conformance</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Runtime must NOT depend on MCP or proprietary modules -->
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-secrets-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-secrets-local</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-consumer-conformance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>codinglair-taf-runtime-core</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-test-definitions</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-test-definitions-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-web-playwright</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-api-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-api-soap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-mobile-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-mobile-appium</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-virtualization-wiremock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-messaging-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-messaging-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-messaging-rabbitmq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-messaging-jms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-environments</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-database</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>taf-data-migration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>codinglair-taf-mcp</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>codinglair-taf-runner-testng</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>
            <dependency>
                <groupId>com.codinglair.taf</groupId>
                <artifactId>codinglair-taf-runner-cucumber</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Surefire (unit tests) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=${project.build.sourceEncoding}</argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Source -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>

            <!-- Dependency convergence and architecture enforcement -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
