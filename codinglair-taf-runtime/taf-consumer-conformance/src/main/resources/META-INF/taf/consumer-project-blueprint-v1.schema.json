{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codinglair.com/taf/schemas/consumer-project-blueprint-v1.schema.json",
  "title": "Codinglair TAF Consumer Project Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "runtime", "capabilities", "runners", "testDefinitions", "reporting"],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1"] },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "basePackage"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "type": { "enum": ["focused-golden", "cross-capability", "consumer", "standalone-test-automation"] },
        "basePackage": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "expectedBuildRoot": { "const": "." },
        "sutInteraction": { "const": "external" }
      }
    },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "type": "string", "minLength": 1, "maxLength": 100 } } },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web-playwright", "rest", "soap", "kafka", "rabbitmq", "jms", "database", "files", "mobile-appium"] } },
    "runners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["testng", "cucumber-testng"] } },
    "testDefinitions": { "type": "object", "additionalProperties": false, "required": ["provider", "authoritative"], "properties": { "provider": { "enum": ["file-csv", "mongodb", "custom"] }, "authoritative": { "const": true } } },
    "reporting": { "type": "object", "additionalProperties": false, "required": ["adapter"], "properties": { "adapter": { "enum": ["allure", "custom"] } } }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": "1.1" } } },
    "then": {
      "properties": {
        "project": {
          "required": ["name", "type", "basePackage", "expectedBuildRoot", "sutInteraction"],
          "properties": { "type": { "const": "standalone-test-automation" } }
        },
        "runners": { "contains": { "const": "testng" } }
      }
    }
  }]
}
