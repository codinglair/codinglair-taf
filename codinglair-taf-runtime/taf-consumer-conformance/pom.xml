<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codinglair.taf</groupId>
        <artifactId>codinglair-taf-runtime</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>taf-consumer-conformance</artifactId>
    <name>TAF Consumer Conformance</name>
    <description>Executable blueprint conformance validator and consumer test kit</description>
    <properties>
        <!-- This module owns the maximal capability graph used by the dependency-analysis gate. -->
        <taf.dependency.convergence.skip>false</taf.dependency.convergence.skip>
    </properties>
    <dependencies>
        <!-- Consume the same public POMs as clean projects; together these form the maximal
             non-messaging starter graph used by context and convergence tests. -->
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>codinglair-taf-starter-web</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>codinglair-taf-starter-api</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>codinglair-taf-starter-database</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>codinglair-taf-starter-mobile</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>taf-messaging-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>taf-messaging-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>taf-messaging-jms</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codinglair.taf</groupId>
            <artifactId>taf-messaging-aws</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
