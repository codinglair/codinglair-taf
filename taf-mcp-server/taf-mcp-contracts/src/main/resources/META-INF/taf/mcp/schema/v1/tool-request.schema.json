{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codinglair:taf:mcp:schema:v1:tool-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "operation",
    "projectId",
    "environment",
    "timeoutSeconds",
    "arguments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "operation": {
      "enum": [
        "discover",
        "validate",
        "scaffold",
        "compile",
        "execute",
        "inspect",
        "retrieve",
        "cancel",
        "report",
        "build",
        "diagnose"
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "approvalReference": {
      "type": "string",
      "pattern": "^approval:[A-Za-z0-9._:-]+$"
    },
    "arguments": {
      "type": "object",
      "maxProperties": 32,
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId",
              "instance",
              "operations"
            ],
            "properties": {
              "capabilityId": {
                "enum": [
                  "aws.eventbridge",
                  "aws.sqs"
                ]
              },
              "instance": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            }
          }
        }
      },
      "$comment": "Property-name rejection is defense in depth only. MCP-003 must redact values and detect secret canaries regardless of field name.",
      "propertyNames": {
        "not": {
          "pattern": "(?i)(password|passphrase|secret|secretValue|token|tokenValue|apiKey|accessToken|authToken|bearerToken|credential|credentials|privateKey|serviceAccountKey|connectionString)$"
        }
      }
    }
  }
}