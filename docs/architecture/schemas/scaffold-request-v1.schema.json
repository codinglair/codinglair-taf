{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codinglair.com/taf/schemas/scaffold-request-v1.schema.json",
  "title": "Codinglair TAF normalized scaffold request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blueprintVersion",
    "groupId",
    "artifactId",
    "basePackage",
    "tafVersion",
    "capabilities",
    "runner",
    "reporting",
    "testDefinitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "blueprintVersion": {
      "const": "1.0"
    },
    "groupId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 200
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "basePackage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 200
    },
    "tafVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "API",
          "DATABASE",
          "MESSAGING",
          "MOBILE",
          "WEB"
        ]
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messaging": {
          "enum": [
            "AWS",
            "JMS",
            "KAFKA",
            "RABBITMQ"
          ]
        }
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "automationName"
      ],
      "properties": {
        "platform": {
          "enum": [
            "ANDROID",
            "IOS",
            "IPADOS",
            "APPLE"
          ]
        },
        "automationName": {
          "enum": [
            "UIAUTOMATOR2",
            "XCUITEST"
          ]
        },
        "family": {
          "enum": [
            "IPHONE",
            "IPAD"
          ]
        },
        "mode": {
          "enum": [
            "NATIVE",
            "HYBRID",
            "SAFARI"
          ]
        },
        "deviceKind": {
          "enum": [
            "SIMULATOR",
            "PHYSICAL"
          ]
        },
        "topology": {
          "enum": [
            "LOCAL_HOST",
            "REMOTE_HOST",
            "PROVIDER"
          ]
        },
        "applicationMode": {
          "enum": [
            "PREINSTALLED",
            "PACKAGED"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"platform": {"const": "APPLE"}}},
          "then": {"required": ["family"]}
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "ANDROID"
              }
            }
          },
          "then": {
            "properties": {
              "automationName": {
                "const": "UIAUTOMATOR2"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "family"
                  ]
                },
                {
                  "required": [
                    "mode"
                  ]
                },
                {
                  "required": [
                    "deviceKind"
                  ]
                },
                {
                  "required": [
                    "topology"
                  ]
                },
                {
                  "required": [
                    "applicationMode"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "automationName": {
                "const": "XCUITEST"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "IOS"
              }
            }
          },
          "then": {
            "properties": {
              "family": {
                "const": "IPHONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "IPADOS"
              }
            }
          },
          "then": {
            "properties": {
              "family": {
                "const": "IPAD"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "SAFARI"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "applicationMode"
              ]
            }
          }
        }
      ]
    },
    "runner": {
      "enum": [
        "TESTNG",
        "CUCUMBER_TESTNG"
      ]
    },
    "reporting": {
      "enum": [
        "ALLURE",
        "NONE"
      ]
    },
    "testDefinitions": {
      "enum": [
        "FILE_CSV",
        "MONGODB"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "MESSAGING"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "required": [
          "providers"
        ]
      },
      "else": {
        "not": {
          "required": [
            "providers"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "MOBILE"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "required": [
          "mobile"
        ]
      },
      "else": {
        "not": {
          "required": [
            "mobile"
          ]
        }
      }
    }
  ]
}
