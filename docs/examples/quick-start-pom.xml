<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.codinglair.taf</groupId>
    <artifactId>codinglair-taf</artifactId>
    <version>${revision}</version>
    <relativePath/>
  </parent>
  <groupId>com.example.automation</groupId>
  <artifactId>my-taf-tests</artifactId>
  <properties>
    <taf.version>${project.version}</taf.version>
    <consumer.source>src/main/java</consumer.source>
    <consumer.test-source>src/test/java</consumer.test-source>
    <consumer.test-resources>src/test/resources</consumer.test-resources>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.codinglair.taf</groupId>
        <artifactId>codinglair-taf-bom</artifactId>
        <version>${taf.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-secrets-local</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-test-definitions</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-test-definitions-mongodb</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-data-migration</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-web-playwright</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-api-rest</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-database</artifactId></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-mobile-appium</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-messaging-kafka</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-messaging-rabbitmq</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-messaging-jms</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-virtualization-wiremock</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>codinglair-taf-reporting-allure</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>codinglair-taf-runner-testng</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>codinglair-taf-runner-cucumber</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.cucumber</groupId><artifactId>cucumber-spring</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.codinglair.taf</groupId><artifactId>taf-consumer-conformance</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${consumer.source}</sourceDirectory>
    <testSourceDirectory>${consumer.test-source}</testSourceDirectory>
    <testResources>
      <testResource><directory>${consumer.test-resources}</directory></testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><release>${java.version}</release><parameters>true</parameters></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId></plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>repository-verification</id>
      <properties>
        <consumer.source>../../demos/playwright-sauce-demo/src/main/java</consumer.source>
        <consumer.test-source>../../demos/playwright-sauce-demo/src/test/java</consumer.test-source>
        <consumer.test-resources>../../demos/playwright-sauce-demo/src/test/resources</consumer.test-resources>
      </properties>
    </profile>
  </profiles>
</project>
