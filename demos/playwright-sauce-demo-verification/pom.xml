<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.codinglair.taf</groupId>
    <artifactId>codinglair-taf</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>playwright-sauce-demo-verification</artifactId>
  <name>TAF SauceDemo Framework Verification</name>
  <description>Nonconsumer JUnit verification for the SauceDemo golden project.</description>
  <dependencies>
    <dependency>
      <groupId>com.codinglair.taf.demo</groupId>
      <artifactId>playwright-sauce-demo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf.demo</groupId>
      <artifactId>playwright-sauce-demo</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-consumer-conformance</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>codinglair-taf-runner-testng</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testSourceDirectory>${maven.multiModuleProjectDirectory}/demos/playwright-sauce-demo/src/test/java</testSourceDirectory>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>${maven.multiModuleProjectDirectory}/demos/playwright-sauce-demo/src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testIncludes>
            <testInclude>**/architecture/**</testInclude>
            <testInclude>**/context/**</testInclude>
            <testInclude>**/integration/**</testInclude>
            <testInclude>**/validation/**</testInclude>
            <testInclude>**/bdd/CucumberMongoIntegrationTest.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <taf.consumer.projectRoot>${maven.multiModuleProjectDirectory}/demos/playwright-sauce-demo</taf.consumer.projectRoot>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
