<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.codinglair.taf</groupId>
    <artifactId>codinglair-taf</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <groupId>com.codinglair.taf.demo</groupId>
  <artifactId>playwright-sauce-demo</artifactId>
  <name>TAF SauceDemo Playwright Golden Project</name>
  <properties>
    <taf.version>${project.version}</taf.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-secrets-local</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-web-playwright</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-api-rest</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-database</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>codinglair-taf-runner-testng</artifactId>
      <version>${taf.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-test-definitions</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-test-definitions-mongodb</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-data-migration</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>codinglair-taf-runner-cucumber</artifactId>
      <version>${taf.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>codinglair-taf-reporting-allure</artifactId>
      <version>${taf.version}</version>
    </dependency>
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-java-commons</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codinglair.taf</groupId>
      <artifactId>taf-consumer-conformance</artifactId>
      <version>${taf.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>release-staging</id>
      <properties><maven.deploy.skip>true</maven.deploy.skip></properties>
    </profile>
    <profile>
      <id>containers</id>
      <properties>
        <taf.migration.containers>true</taf.migration.containers>
      </properties>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><systemPropertyVariables>
          <taf.migration.containers>${taf.migration.containers}</taf.migration.containers>
        </systemPropertyVariables></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>functional-suite</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.apache.maven.surefire</groupId>
                <artifactId>surefire-testng</artifactId>
                <version>${maven.surefire.plugin.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <suiteXmlFiles>
                <suiteXmlFile>src/test/resources/suites/testng-functional.xml</suiteXmlFile>
              </suiteXmlFiles>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>bdd-suite</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.apache.maven.surefire</groupId>
                <artifactId>surefire-testng</artifactId>
                <version>${maven.surefire.plugin.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <suiteXmlFiles>
                <suiteXmlFile>src/test/resources/suites/testng-bdd.xml</suiteXmlFile>
              </suiteXmlFiles>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>browser-smoke</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.apache.maven.surefire</groupId>
                <artifactId>surefire-testng</artifactId>
                <version>${maven.surefire.plugin.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <suiteXmlFiles>
                <suiteXmlFile>src/test/resources/suites/testng-functional.xml</suiteXmlFile>
              </suiteXmlFiles>
              <systemPropertyVariables>
                <taf.browser.smoke>true</taf.browser.smoke>
                <spring.profiles.active>local</spring.profiles.active>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
